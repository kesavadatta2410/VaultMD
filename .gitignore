# ============================================================
# VaultMD — .gitignore
# ============================================================

# --- Java / Maven ---
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.ear

# --- Python ---
ai-service/__pycache__/
ai-service/**/__pycache__/
__pycache__/
**/__pycache__/
ai-service/.pytest_cache/
.pytest_cache/
ai-service/venv/
ai-service/.venv/
venv/
.venv/
*.pyc
*.pyo
*.pyd
.Python
dist/
build/
eggs/
*.egg-info/
*.egg
.eggs/

# --- Python virtualenv (vault/ was accidentally committed) ---
vault/

# --- Chroma / vector-store data ---
ai-service/chroma_data/
chroma_data/

# --- Environment / secrets ---
.env
.env.*
*.env.local
*.env.production
*.env.staging
!.env.example

# --- IDE ---
.idea/
.vscode/
*.iml
*.swp
*.swo
.project
.classpath
.settings/

# --- OS ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Node (if any tooling is added) ---
node_modules/
package-lock.json
yarn.lock

# --- Docker ---
.docker/

# --- Test output ---
coverage/
.coverage
htmlcov/
# NOTE: previously "*.xml" here, which silently excluded backend/pom.xml
# from every commit (Maven's own POM file is XML). Scoped narrowly instead.
**/target/surefire-reports/*.xml
surefire-reports/
