# VaultMD — .gitattributes
# Normalise line endings: store LF in the repo, checkout as-is on all platforms.

* text=auto eol=lf

# Force binary files to avoid corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.tar binary

# Java / Maven
*.java text eol=lf
*.xml text eol=lf
pom.xml text eol=lf

# Python
*.py text eol=lf
requirements.txt text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Config / docs
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf
