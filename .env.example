# Environment Configuration

# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.
#
# Usage with Docker Compose:
#   cp .env.example .env
#   # Edit .env with your real values
#   docker-compose up --build

# ── PostgreSQL ─────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vaultmd
DB_USER=vaultmd
# REQUIRED: change this in any non-local environment
DB_PASSWORD=change-me-in-production

# ── JWT ────────────────────────────────────────────────────
# REQUIRED: must be at least 32 characters (256 bits) of random data.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# JWT token lifetime in milliseconds. Default = 8 hours (28800000 ms).
# Reduce this in production and implement refresh tokens.
JWT_EXPIRATION_MS=28800000

# ── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000

# Optional: set to get LLM-generated answers instead of extractive fallback.
# Without this, /query returns the most relevant chunk verbatim.
# OPENAI_API_KEY=sk-...

# OpenAI model to use (only applies when OPENAI_API_KEY is set)
OPENAI_MODEL=gpt-4o-mini

# Sentence-Transformers embedding model name (must be HuggingFace Hub model ID)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Number of chunks returned by the vector store per query
TOP_K=4

# Chroma vector store persistence directory (inside the container)
CHROMA_PERSIST_DIR=/data/chroma

# ── Emergency Access ───────────────────────────────────────
# How many hours a logged emergency access counts as an active grant
EMERGENCY_ACCESS_VALIDITY_HOURS=12

# ── CORS ───────────────────────────────────────────────────
# Restrict this to your frontend domain in production.
# Wildcard is fine for local demo (no cookies used for auth).
CORS_ALLOWED_ORIGINS=*
